+def _accum_window_bounds(
+    local_step_rel: int, num_steps: int, accum_steps: int
+) -> tuple[bool, bool]:
+    """Locate a micro-batch inside its gradient-accumulation window.
+
+    `local_step_rel` is the 1-based position in the (unskipped) epoch.
+
+    Returns `(window_start, window_end)`: gradients are zeroed on
+    `window_start` and the optimizer steps on `window_end`. The epoch's final
+    micro-batch is always a `window_end`, so a trailing partial window is
+    flushed instead of dropped.
+
+    The start test subtracts 1 because `local_step_rel % accum_steps == 1`
+    never holds when `accum_steps == 1`, which would leave gradients unzeroed
+    forever on the default configuration.
+
+    (Ported from `sy5537/speculators-ty5537`.)
+    """
+    window_start = (local_step_rel - 1) % accum_steps == 0
+    window_end = local_step_rel % accum_steps == 0 or local_step_rel == num_steps
+    return window_start, window_end
+
